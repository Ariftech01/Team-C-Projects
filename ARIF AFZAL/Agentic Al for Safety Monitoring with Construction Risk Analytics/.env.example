# ==============================================================================
# Agentic AI for Safety Monitoring with Construction Risk Analytics
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL / Supabase / SQLite)
# For local SQLite: sqlite:///./construction_intelligence_hub.db
# For PostgreSQL / Supabase: postgresql://postgres:password@db.example.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./construction_intelligence_hub.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SSL_MODE=prefer

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication
SECRET_KEY=your-secure-secret-key-32-chars-long
JWT_SECRET=your-secure-jwt-secret-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging Configuration
LOG_LEVEL=INFO

# AI & LLM Service Configuration
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=llama3.2
