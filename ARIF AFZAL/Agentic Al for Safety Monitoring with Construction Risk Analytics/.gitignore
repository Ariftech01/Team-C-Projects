# ==============================================================================
# Git Ignore - Agentic AI for Safety Monitoring with Construction Risk Analytics
# ==============================================================================

# Environment / Secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Testing & Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.coverage.*

# Build artifacts & distributions
dist/
build/
*.egg-info/

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Streamlit secrets & local state
.streamlit/secrets.toml

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS Generated Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo