# ==========================================
# CIH - Git Ignore
# ==========================================

# Environment / Secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Testing
.pytest_cache/
.coverage
htmlcov/
.coverage.*

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# Streamlit secrets
.streamlit/secrets.toml

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp